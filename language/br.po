#: Module.php:78
msgid "WARNING"
msgstr "Diwallit"

#: Module.php:80
#, php-format, python-format
msgid ""
"%d digital objects still exist. Without conversion, files and derivatives "
"will be left on disk."
msgstr ""
"%d objedoù niverel a chom c'hoazh. Hep treuzfurmadur e chomo ar restroù hag "
"an deveradoù war an disk."

#: Module.php:85
msgid ""
"Convert digital objects back to media before uninstalling (synchronous, may "
"be long)."
msgstr ""
"Treiñ an objedoù niverel en-dro da vediaoù a-raok an dizstaliañ (kenamzeriet,"
" gallout a ra padout pell)."

#: Module.php:106
#, php-format, python-format
msgid ""
"Cannot uninstall: %d digital objects still exist. Tick the conversion "
"checkbox in the uninstall confirmation, or convert/delete them beforehand."
msgstr ""
"N'haller ket diinstallañ : %d objed niverel a chom c'hoazh. Asennit ar voest "
"da zibab evit an treuzfurmadur e kadarnaadenn an diinstaladur, pe "
"treuzfurmit/diverkit anezho en a-raok."

#: Module.php:123
#, php-format, python-format
msgid ""
"Conversion incomplete: %d digital objects could not be converted. Check job "
"logs and retry."
msgstr ""
"Treiñ diglok : %d objed niverel n'int ket bet treuzfurmet. Gwiriit marilhoù "
"al labour ha klaskit en-dro."

#: Module.php:138
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Ar modul %1$s a zlefe bezañ hizivaet d'ar stumm %2$s pe unan nevesoc'h."

