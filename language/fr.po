#: Module.php:139
msgid "WARNING"
msgstr "ATTENTION"

#: Module.php:142
#, php-format
msgid ""
"%d digital objects still exist. Without conversion, files and derivatives "
"will be left on disk."
msgstr ""
"Il reste encore %d objets numériques. Sans conversion, les fichiers et leurs "
"dérivés resteront sur le disque."

#: Module.php:147
msgid ""
"Convert digital objects back to media before uninstalling (synchronous, may "
"be long)."
msgstr ""
"Restaurer les objets numériques en médias avant la désinstallation "
"(traitement en ligne pouvant être long)."

#: Module.php:168
#, php-format
msgid ""
"Cannot uninstall: %d digital objects still exist. Tick the conversion "
"checkbox in the uninstall confirmation, or convert/delete them beforehand."
msgstr ""
"Impossible de désinstaller : il reste %d objets numériques. Cochez la case "
"de conversion dans la fenêtre de confirmation de désinstallation, ou "
"convertissez-les ou supprimez-les au préalable."

#: Module.php:185
#, php-format
msgid ""
"Conversion incomplete: %d digital objects could not be converted. Check job "
"logs and retry."
msgstr ""
"Conversion incomplète : %d objets numériques n'ont pas pu être convertis. "
"Vérifiez les journaux et réessayez."

#: Module.php:200
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Le module %1$s doit être mis à niveau à la version %2$s ou supérieure."

