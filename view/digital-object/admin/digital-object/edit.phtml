$form->prepare();
?>
<?= $this->pageTitle($do->displayTitle(), 1, $translate('Digital object')) ?>

<?= $this->form()->openTag($form) ?>

<?= $this->sectionNav([
    'resource-values' => $translate('Values'),
    'digital-object-file' => $translate('File'),
    'advanced-settings' => $translate('Advanced'),
]) ?>

<?= $this->partial('common/resource-fields.phtml', [
    'form' => $form,
    'resource' => $do,
    'action' => 'edit',
    'postedValues' => $postedValues ?? null,
]) ?>

<fieldset id="digital-object-file" class="section" aria-labelledby="digital-object-file-label">
    <h3 id="digital-object-file-label"><?= $translate('File') ?></h3>
    <ul class="messages">
        <li class="notice"><?= $translate('The file is immutable. To replace it, delete this digital object and create a new one.') ?></li>
    </ul>
    <?php if ($do->hasThumbnails()): ?>
        <img src="<?= $escape($do->thumbnailUrl('medium')) ?>" alt="">
    <?php endif; ?>
    <dl>
        <dt><?= $translate('Source') ?></dt><dd><?= $escape($do->source() ?? '—') ?></dd>
