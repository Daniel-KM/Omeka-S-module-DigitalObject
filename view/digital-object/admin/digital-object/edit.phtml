        <dt><?= $translate('Size') ?></dt><dd><?= $do->size() ? sprintf($translate('%s bytes'), $escape(number_format($do->size()))) : '—' ?></dd>
        <dt><?= $translate('SHA-256') ?></dt><dd><?= $escape($do->sha256() ?? '—') ?></dd>
        <dt><?= $translate('Storage ID') ?></dt><dd><?= $escape($do->storageId() ?? '—') ?></dd>
    </dl>
</fieldset>

